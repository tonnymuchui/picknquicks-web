# Public Supabase connection (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_replace_me
APP_URL=https://www.picknquicks.com/
NEXT_PUBLIC_SITE_URL=https://www.picknquicks.com/
GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
CRON_SECRET=replace-with-a-long-random-value

# Daraja 3.0 / M-Pesa Express
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace_me
DARAJA_CONSUMER_SECRET=replace_me
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=replace_me
DARAJA_CALLBACK_TOKEN=replace-with-a-long-random-value
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Resend (use a verified sending domain in production)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=PicknQuicks <receipts@picknquicks.com>

# Store contact
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_MPESA_TILL_NUMBER=replace_with_your_till_number
